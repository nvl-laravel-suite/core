{
    "name": "nvl/core",
    "description": "Native Laravel support contracts, configuration, model identity, and ownership ports",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "support",
        "ownership"
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.2",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.0",
        "nvl/activity": "^6.0",
        "nvl/auth": "^6.0",
        "nvl/billing": "^6.0",
        "nvl/comments": "^6.0",
        "nvl/content": "^6.0",
        "nvl/csv": "^6.0",
        "nvl/filterable": "^6.0",
        "nvl/forms": "^6.0",
        "nvl/mail-notifications": "^6.0",
        "nvl/media": "^6.0",
        "nvl/metafields": "^6.0",
        "nvl/pages": "^6.0",
        "nvl/payments": "^6.0",
        "nvl/primitives": "^6.0",
        "nvl/seo": "^6.0",
        "nvl/settings": "^6.0",
        "nvl/tasks": "^6.0",
        "nvl/taxonomy": "^6.0",
        "nvl/templates": "^6.0",
        "nvl/tenancy": "^6.0",
        "nvl/translatable": "^6.0",
        "nvl/translations": "^6.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.2.5",
        "phpunit/php-code-coverage": "^12.0",
        "phpunit/phpunit": "^12.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0",
        "symfony/process": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Support\\": "support/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Data\\": "data/src/",
            "Nvl\\Support\\Tests\\": "support/tests/",
            "Nvl\\Data\\Tests\\": "data/tests/"
        },
        "exclude-from-classmap": [
            "support/tests/Feature/QueueEnvelopeIsolationTest.php",
            "support/tests/Feature/PackageStorageTest.php",
            "support/tests/Feature/NamespacedPublicationsTest.php",
            "support/tests/PHPStan/Fixtures/"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Support\\Providers\\SupportServiceProvider",
                "Nvl\\Support\\Providers\\LocaleServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/Pest.php",
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/support/.temp",
            "/support/.gitattributes",
            "/support/.gitignore",
            "/support/tests",
            "/support/phpstan.neon.dist",
            "/support/phpunit.xml.dist",
            "/support/composer.json",
            "/support/consumer-audit.neon",
            "/support/resources/consumer-api.json",
            "/support/src/Consumer",
            "/support/stubs-events.stub",
            "/data",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "nvl/data": "*",
        "nvl/support": "*"
    },
    "homepage": "https://github.com/nvl-laravel-suite/core",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/core",
        "docs": "https://github.com/nvl-laravel-suite/core#readme",
        "issues": "https://github.com/nvl-laravel-suite/core/issues",
        "security": "https://github.com/nvl-laravel-suite/core/security/policy"
    }
}
