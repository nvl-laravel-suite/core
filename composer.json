{
    "name": "nvl/core",
    "description": "Shared NVL support contracts and data transformation infrastructure for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "support", "data-transfer-object", "typescript"],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2",
        "laravel/framework": "^13.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "ext-zip": "Enables downloadable archives for the generated TypeScript declaration API."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Support\\": "support/src/",
            "Nvl\\Data\\": "data/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Support\\Tests\\": "support/tests/",
            "Nvl\\Data\\Tests\\": "data/tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Support\\Providers\\SupportServiceProvider",
                "Nvl\\Data\\Providers\\DataServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/Pest.php",
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/support/.temp",
            "/support/.gitattributes",
            "/support/.gitignore",
            "/support/tests",
            "/support/phpstan.neon.dist",
            "/support/phpunit.xml.dist",
            "/support/composer.json",
            "/data/.temp",
            "/data/.gitattributes",
            "/data/.gitignore",
            "/data/composer-require-checker.json",
            "/data/tests",
            "/data/phpstan.neon.dist",
            "/data/phpunit.xml.dist",
            "/data/composer.json"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
