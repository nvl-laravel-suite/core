{
    "name": "nvl/core",
    "description": "Shared NVL support contracts and data transformation infrastructure for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "support",
        "data-transfer-object",
        "typescript"
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.2",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.2.5",
        "phpunit/phpunit": "^12.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0",
        "symfony/process": "^7.0 || ^8.0"
    },
    "suggest": {
        "ext-zip": "Enables downloadable archives for the generated TypeScript declaration API.",
        "larastan/larastan": "Provide Laravel-aware receiver types for optional consumer boundary analysis (^3.10).",
        "phpstan/phpstan": "Enable optional consumer boundary analysis with PHPStan ^2.2.5 and support/consumer-audit.neon."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Support\\": "support/src/",
            "Nvl\\Data\\": "data/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Support\\Tests\\": "support/tests/",
            "Nvl\\Data\\Tests\\": "data/tests/"
        },
        "exclude-from-classmap": [
            "support/tests/Feature/QueueEnvelopeIsolationTest.php",
            "support/tests/Feature/PackageStorageTest.php",
            "support/tests/Feature/NamespacedPublicationsTest.php",
            "support/tests/PHPStan/Fixtures/"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Support\\Providers\\SupportServiceProvider",
                "Nvl\\Data\\Providers\\DataServiceProvider",
                "Nvl\\Support\\Providers\\LocaleServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/Pest.php",
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/support/.temp",
            "/support/.gitattributes",
            "/support/.gitignore",
            "/support/tests",
            "/support/phpstan.neon.dist",
            "/support/phpunit.xml.dist",
            "/support/composer.json",
            "/data/.temp",
            "/data/.gitattributes",
            "/data/.gitignore",
            "/data/composer-require-checker.json",
            "/data/tests",
            "/data/phpstan.neon.dist",
            "/data/phpunit.xml.dist",
            "/data/composer.json",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "nvl/data": "*",
        "nvl/support": "*"
    },
    "homepage": "https://github.com/nvl-laravel-suite/core",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/core",
        "docs": "https://github.com/nvl-laravel-suite/core#readme",
        "issues": "https://github.com/nvl-laravel-suite/core/issues",
        "security": "https://github.com/nvl-laravel-suite/core/security/policy"
    }
}
