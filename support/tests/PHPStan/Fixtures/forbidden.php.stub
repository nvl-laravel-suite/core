<?php

declare(strict_types=1);

namespace ConsumerBoundaryFixtures;

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Support\Facades\DB;
use Nvl\Comments\Models\Comment;
use Nvl\Comments\Services\CommentAccessService;

/**
 * @param  Builder<Comment>  $query
 * @param  Collection<int, Comment>  $comments
 */
function forbidden(Comment $comment, Builder $query, Collection $comments): void
{
    Comment::query();
    $comment->save();
    $comment->refresh();
    $comment->body;
    $comment->id = 'replacement';
    $comment['body'];
    $comment['id'] = 'replacement';
    $comment->toArray();
    json_encode($comment);
    $query->where('visibility', 'public');
    $query->update(['body' => 'changed']);
    $comments->toArray();
    $comments->pluck('body');
    DB::table('nvl_comments_comments');
}
