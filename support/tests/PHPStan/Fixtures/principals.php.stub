trait HostRoleAliases
{
    use HasRoles {
        assignRole as grantNative;
        roles as nativeRoleRows;
    }
}

class HostPrincipal extends User
{
    use HasAttributes {
        getArrayableRelations as public nativeRelations;
        getRelationshipFromMethod as public nativeRelationFromMethod;
    }

    use HasRelationships {
        getRelation as nativeRelation;
    }

    use HasRoles {
        assignRole as aliasAssignRole;
        roles as aliasRoles;
        detachRoles as public clearNativeRoles;
        detachPermissions as public clearNativePermissions;
        getStoredRole as public nativeRole;
        collectRoles as public nativeRoleIds;
        getStoredPermission as public nativePermission;
        convertToPermissionModels as public nativePermissionModels;
        collectPermissions as public nativePermissionIds;
    }

    use HostRoleAliases {
        grantNative as grantAccount;
    }

    public string $businessLabel;

    public function __construct()
    {
        throw new \LogicException('Consumer checks must never execute a host principal constructor.');
    }

    /** @return BelongsTo<HostBusiness, $this> */
    public function business(): BelongsTo
    {
        return $this->belongsTo(HostBusiness::class);
    }
}

class HostBusiness extends Model
{
    /** @return BelongsTo<HostPrincipal, $this> */
    public function owner(): BelongsTo
    {
        return $this->belongsTo(HostPrincipal::class);
    }
}

class ForeignHostChild extends \ConsumerForeignFixtures\PackagePrincipal {}

class OverriddenHostAlias extends User
{
    use HasRoles {
        assignRole as hostBusinessOperation;
    }

    public function hostBusinessOperation(): string
    {
        return 'host business';
    }
}

function overriddenAlias(OverriddenHostAlias $host): void
{
    $host->hostBusinessOperation();
}

